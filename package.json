{
  "name": "mini-blog-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npx nodemon --workspace=backend\"",
    "install:all": "npm install --workspaces",
    "lint": "npm run lint --workspaces",
    "start": "npm run start --workspace=backend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "eslint": "^9.29.0"
  },
  "dependencies": {
    "dotenv": "^16.5.0"
  }
}
